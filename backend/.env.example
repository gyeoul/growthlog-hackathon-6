# Copy to `.env` and fill in. Only SESSION_SECRET and the Google pair matter for auth.

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# Authorized redirect URI must match OAUTH_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google sends the browser back. Goes through the Next.js proxy on :3000.
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Signs the session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Session lifetime in seconds (default 7 days)
SESSION_TTL=604800

# The only email domain allowed to become a member
ALLOWED_EMAIL_DOMAIN=knou.ac.kr

# Set to 1 when served over HTTPS (production)
COOKIE_SECURE=0

# SQLite file. Relative paths resolve against the backend/ directory, so the
# same file is used no matter where uvicorn is started from.
DATABASE_PATH=app.db
